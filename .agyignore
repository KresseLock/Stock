# ==========================================
# 核心開發忽略設定 - 讓 AI Agent 專注於程式碼
# ==========================================

# 1. 忽略所有爬蟲抓下來的大數據與外部檔案
data/
*.csv
*.parquet
*.xlsx
*.json

# 允許 AI 讀取重要的設定與快取 JSON 檔
!best_factors.json
!best_trading_params.json
!scripts/stock_categories.json
!models/feature_cols.json
!data/failed_dates.json
!data/no_finmind_data.json
!data/skip_dates.json
!data/missing_fm_datasets.json

# ==========================================
# * AI 學習特許區 (白名單)
# 允許 AI 讀取 sample_data 資料夾內的微型樣本
# ==========================================
!sample_data/
!sample_data/**/*.csv
!sample_data/**/*.parquet

# 2. 忽略模型權重與機器學習產出
models/*
*.pkl
*.bst
*.lightgbm

# 3. 忽略 Python 環境與快取 (防干擾)
venv/
.antigravitycli/
__pycache__/
*.pyc
.ipynb_checkpoints/

# 4. 忽略系統日誌與暫存檔
*.log
temp/
.DS_Store
Thumbs.db
FINMIND_TOKEN.txt
reports/
predictions/

# rclone 雲端密鑰與設定檔 (防外洩)
config
config/
.config
.config/
rclone.conf
rclone.conf.bak

# 本地臨時/除錯腳本
scratch/